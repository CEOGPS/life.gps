{
   "action": {
      "default_popup": "popup.html",
      "default_title": "Browser Not Supported"
   },
   "background": {
      "service_worker": "background.js"
   },
   "content_scripts": [ {
      "js": [ "content-scripts/content.js" ],
      "matches": [ "http://*/*", "https://*/*" ]
   } ],
   "default_locale": "en",
   "description": "__MSG_shortDesc__",
   "host_permissions": [ "\u003Call_urls>" ],
   "icons": {
      "128": "icon/128.png",
      "16": "icon/16.png",
      "48": "icon/48.png",
      "64": "icon/64.png",
      "96": "icon/96.png"
   },
   "key": "",
   "manifest_version": 3,
   "name": "__MSG_appName__",
   "options_ui": {
      "page": "options.html"
   },
   "permissions": [ "activeTab", "downloads", "storage", "sidePanel", "scripting", "offscreen" ],
   "side_panel": {
      "default_path": "sidepanel.html"
   },
   "update_url": "https://clients2.google.com/service/update2/crx",
   "version": "3.0.24",
   "web_accessible_resources": [ {
      "matches": [ "http://*/*", "https://*/*" ],
      "resources": [ "icon/16.png", "data/Extension-Technologies.html" ]
   } ]
}
