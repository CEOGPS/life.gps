{
   "action": {
      "default_icon": "icons/icon48.png",
      "default_popup": "popup.html"
   },
   "author": "Krofile",
   "background": {
      "service_worker": "background.js"
   },
   "content_scripts": [ {
      "js": [ "js/content.js" ],
      "matches": [ "*://*.facebook.com/*" ]
   }, {
      "js": [ "js/ExtPay.js" ],
      "matches": [ "https://extensionpay.com/*" ],
      "run_at": "document_start"
   } ],
   "description": "Extract contact info from Facebook profiles, pages & groups. Emails, phones, social links & 30+ data points. One-click CSV export.",
   "homepage_url": "https://extractmyleads.com",
   "host_permissions": [ "https://extensionpay.com/*" ],
   "icons": {
      "128": "icons/icon128.png",
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
   },
   "key": "",
   "manifest_version": 3,
   "name": "Extract My Leads - Facebook Contact Extractor",
   "permissions": [ "notifications", "storage" ],
   "update_url": "https://clients2.google.com/service/update2/crx",
   "version": "2.1.0",
   "web_accessible_resources": [ {
      "matches": [ "\u003Call_urls>" ],
      "resources": [ "js/ExtPay.js" ]
   } ]
}
