{
   "action": {
      "default_icon": {
         "128": "icons/icon128.png"
      },
      "default_popup": "popup.html",
      "default_title": "SnapCode Pro"
   },
   "background": {
      "service_worker": "background.js"
   },
   "content_scripts": [ {
      "css": [ "styles.css" ],
      "js": [ "content.js" ],
      "matches": [ "\u003Call_urls>" ]
   } ],
   "description": "Capture the Design, Extract the Code. High-fidelity HTML/CSS extraction and intelligent full-page screenshots for modern developers.",
   "icons": {
      "128": "icons/icon128.png"
   },
   "key": "",
   "manifest_version": 3,
   "name": "SnapCode Pro",
   "permissions": [ "activeTab", "scripting", "storage", "downloads", "tabs" ],
   "update_url": "https://clients2.google.com/service/update2/crx",
   "version": "1.0.1",
   "web_accessible_resources": [ {
      "matches": [ "\u003Call_urls>" ],
      "resources": [ "styles.css" ]
   } ]
}
