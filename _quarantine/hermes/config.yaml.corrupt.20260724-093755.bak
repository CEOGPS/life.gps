# ============ IDE PLUGIN CONFIGURATIONS ============
ide_integrations:
  vscode:
    enabled: true
    extension: hermes-vscode
    commands:
      - code .
      - code --goto
      - code --diff
      - code --install-extension
      - code --list-extensions
      
  cursor:
    enabled: true
    commands:
      - cursor .
      - cursor --goto
      
  intellij:
    enabled: true
    commands:
      - idea .
      - idea --line
      
  neovim:
    enabled: true
    commands:
      - nvim
      - nvim +PluginInstall
      - nvim +LspInstall

# ============ TESTING FRAMEWORK CONFIG ============
testing:
  frameworks:
    pytest:
      patterns:
        - test_*.py
        - *_test.py
      commands:
        - pytest
        - pytest -v
        - pytest -x
        - pytest --cov
        - pytest --cov-report
        - pytest --pdb
        
    jest:
      patterns:
        - *.test.js
        - *.spec.js
      commands:
        - npm test
        - npm run test:watch
        - npm run test:coverage
        - npm run test:ui
        
    vitest:
      patterns:
        - *.test.js
        - *.spec.js
      commands:
        - vitest
        - vitest run
        - vitest watch
        - vitest coverage
        
    cargo_test:
      patterns:
        - tests/*.rs
      commands:
        - cargo test
        - cargo test -- --nocapture
        - cargo test -- --test-threads=1

# ============ CODE EXECUTION ============
code_execution:
  max_tool_calls: 150
  timeout: 600
  memory_limit: 2048
  
  # Language-specific settings
  languages:
    python:
      interpreter: python3
      packages: pip
      formatter: black
      linter: ruff
      test: pytest
      
    javascript:
      interpreter: node
      packages: npm
      formatter: prettier
      linter: eslint
      test: jest
      
    typescript:
      interpreter: node
      packages: npm
      formatter: prettier
      linter: eslint
      compiler: tsc
      test: jest
      
    rust:
      interpreter: cargo
      packages: cargo
      formatter: rustfmt
      linter: clippy
      test: cargo test

terminal:
  backend: local
  container_cpu: 4
  container_disk: 102400
  container_memory: 16384
  container_persistent: true
  cwd: C:/dev/LifeOS1
  docker_mount_cwd_to_workspace: true
  home_mode: auto
  lifetime_seconds: 3600
  path_prefix: C:/Users/chris/AppData/Local/hermes/bin;C:/Program Files/nodejs
  timeout: 600

# ============ DELEGATION ============
delegation:
  max_iterations: 100
  model: qwen2.5-coder:14b
  provider: ollama-local
  reasoning_effort: maximum
  auto_configure: true
  cost_aware: true  # Prioritize free models
  smart_routing: true  # Route to best free model for task

# ============ GUARDRAILS ============
tool_loop_guardrails:
  hard_stop_after:
    exact_failure: 8
    idempotent_no_progress: 8
    same_tool_failure: 6
  hard_stop_enabled: true
  warn_after:
    exact_failure: 3
    idempotent_no_progress: 3
    same_tool_failure: 3
  warnings_enabled: true

# ============ BROWSER ============
browser:
  allow_private_urls: true
  inactivity_timeout: 300
  headless: false
  user_agent: "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36"

# ============ DISPLAY ============
display:
  background_process_notifications: all
  bell_on_complete: true
  busy_ack_detail: true
  busy_input_mode: interrupt
  cleanup_progress: false
  compact: false
  interim_assistant_messages: true
  long_running_notifications: true
  personality: concise
  show_reasoning: true
  skin: default
  streaming: true
  tool_progress: all
  debug_mode: true

# ============ CHECKPOINTS ============
checkpoints:
  enabled: true
  checkpoint_dir: ~/.hermes/checkpoints
  auto_save: true
  save_interval: 5  # Save every 5 turns

# ============ UPDATES ============
updates:
  backup_keep: 10
  non_interactive_local_changes: stash
  pre_update_backup: true
  auto_update: true

# ============ STREAMS ============
streaming:
  enabled: true
  chunk_size: 100

# ============ SECURITY ============
security:
  allow_private_urls: true
  sandbox_level: moderate
  file_access: project_only  # Restrict to project directory
  network_access: limited  # Only allow outbound to known services

# ============ SESSION ============
session_reset:
  at_hour: 5
  idle_minutes: 2880
  mode: gentle

# ============ ONBOARDING ============
onboarding:
  seen:
    busy_input_prompt: true
    tool_progress_prompt: true