_config_version: 33

# ============ AGENT INTELLIGENCE ============
agent:
  api_max_retries: 5
  max_turns: 300
  personalities:
    webgod: |
      You are Erebus, a godlike systems architect and principal engineer with 30 years of experience.
      
      INTELLIGENCE PROTOCOL:
      - Reason from first principles
      - Consider entire system stack (hardware→kernel→runtime→app)
      - Use formal methods where applicable (type theory, TLA+, invariants)
      - Write code that is: correct → maintainable → performant → secure
      - When debugging: hypothesize → test → eliminate → iterate
      - Document architectural decisions with context and rationale
      
      FREE MODEL STRATEGY:
      - Use open-source models for routine coding (Qwen, DeepSeek)
      - Use reasoning models (Claude/Gemini free tiers) for architecture
      - Cache and reuse solutions to minimize API calls
      - Batch operations when possible
      
      You are assisting Chris, CEO of CEO GPS digital marketing.
  reasoning_effort: maximum
  service_tier: free  # Changed to prioritize free tiers
  verbose: true

# ============ INTELLIGENT MODEL ROUTING ============
model:
  # Default: Best free reasoning model
  default: google/gemini-2.0-flash-exp:free
  provider: openrouter
  
  # Task-specific routing
  routing:
    reasoning: google/gemini-2.0-pro-exp-02-05:free  # Best free reasoning
    coding: qwen/qwen-2.5-coder-32b-instruct:free    # Best free coding
    debugging: deepseek/deepseek-v4-pro:free         # Deep analysis
    architecture: anthropic/claude-3-haiku:free      # Quick but capable
    simple: microsoft/phi-3.5-mini-128k-instruct:free # Fast tiny model

# ============ PROVIDERS (All Free) ============
providers:
  # OpenRouter - Access to all free models
  openrouter:
    base_url: https://openrouter.ai/api/v1
    default_model: google/gemini-2.0-flash-exp:free
    models:
      # REASONING (Free)
      - google/gemini-2.0-pro-exp-02-05:free     # Best free reasoning
      - google/gemini-2.0-flash-exp:free         # Fast reasoning
      - anthropic/claude-3-haiku:free            # Quick but capable
      - deepseek/deepseek-v4-pro:free            # Deep analysis
      
      # CODING (Free)
      - qwen/qwen-2.5-coder-32b-instruct:free    # Best free coder
      - deepseek/deepseek-coder-6.7b-instruct:free # Good for routine
      - mistral/mistral-7b-instruct:free         # General purpose
      - meta-llama/llama-3.3-70b-instruct:free   # Strong fallback
      
      # FAST/TINY (Free)
      - microsoft/phi-3.5-mini-128k-instruct:free # 3.8B params
      - google/gemini-2.0-flash-lite-preview-02-05:free # Extremely fast
      
      # SPECIALIZED (Free)
      - nousresearch/hermes-2-pro-llama-3-8b:free # Agentic tasks
      - perplexity/llama-3.1-sonar-small-128k-online:free # Web search
    timeout: 120
    max_retries: 3
    extra_body:
      include_reasoning: true  # Get thinking process from models

  # Ollama - Local free models (zero cost)
  ollama-local:
    base_url: http://localhost:11434/v1
    default_model: qwen2.5-coder:14b
    models:
      - qwen2.5-coder:14b      # Best local coder
      - deepseek-coder:6.7b    # Good for debugging
      - llama3.3:latest        # General purpose
      - phi3.5:3.8b            # Fast fallback
      - codellama:13b          # Code-specific
    extra_body:
      enable_thinking: true
      temperature: 0.3
      top_p: 0.9

# ============ MOA WITH FREE MODELS ============
moa:
  enabled: true
  fanout: per_iteration
  max_tokens: 8192
  min_models: 3  # At least 3 models per decision
  
  aggregator:
    model: google/gemini-2.0-flash-exp:free  # Fast aggregator
    provider: openrouter
    temperature: 0.3
  
  reference_models:
    # Reasoning specialist (free)
    - model: google/gemini-2.0-pro-exp-02-05:free
      provider: openrouter
      temperature: 0.2
      weight: 1.0  # Highest weight for reasoning
      
    # Code generation specialist (free)
    - model: qwen/qwen-2.5-coder-32b-instruct:free
      provider: openrouter
      temperature: 0.2
      weight: 1.0  # Highest weight for coding
      
    # Deep analysis (free)
    - model: deepseek/deepseek-v4-pro:free
      provider: openrouter
      temperature: 0.3
      weight: 0.8
      
    # Quick verification (free)
    - model: meta-llama/llama-3.3-70b-instruct:free
      provider: openrouter
      temperature: 0.1
      weight: 0.6
      
    # Alternative perspective (free)
    - model: mistral/mistral-7b-instruct:free
      provider: openrouter
      temperature: 0.7
      weight: 0.5
      
    # Fast tiny model for syntax checking (free)
    - model: microsoft/phi-3.5-mini-128k-instruct:free
      provider: openrouter
      temperature: 0.1
      weight: 0.3
      
  presets:
    # Architecture decisions - use all reasoning models
    architecture:
      fanout: per_iteration
      aggregator_model: google/gemini-2.0-flash-exp:free
      min_models: 4
      reference_models:
        - google/gemini-2.0-pro-exp-02-05:free
        - deepseek/deepseek-v4-pro:free
        - qwen/qwen-2.5-coder-32b-instruct:free
        - meta-llama/llama-3.3-70b-instruct:free
        
    # Debugging - use coding + reasoning models
    debugging:
      fanout: per_iteration
      aggregator_model: google/gemini-2.0-flash-exp:free
      min_models: 4
      reference_models:
        - qwen/qwen-2.5-coder-32b-instruct:free
        - deepseek/deepseek-coder-6.7b-instruct:free
        - google/gemini-2.0-pro-exp-02-05:free
        - mistral/mistral-7b-instruct:free
        
    # Simple coding - use fast models
    simple_coding:
      fanout: per_turn
      aggregator_model: microsoft/phi-3.5-mini-128k-instruct:free
      min_models: 2
      reference_models:
        - deepseek/deepseek-coder-6.7b-instruct:free
        - qwen/qwen-2.5-coder-32b-instruct:free

# ============ SMART CACHING (Save credits) ============
prompt_caching:
  cache_ttl: 30m  # Cache for 30 minutes
  enabled: true
  max_cache_size: 1000  # Store 1000 responses
  similarity_threshold: 0.9  # High threshold for exact matches

memory:
  flush_min_turns: 10  # More context before flushing
  memory_char_limit: 5000
  memory_enabled: true
  nudge_interval: 12
  user_char_limit: 2500
  user_profile_enabled: true
  embedding_model: togethercomputer/m2-bert-80M-8k-retrieval:free  # Free embedding

compression:
  enabled: true
  protect_first_n: 5
  protect_last_n: 30
  target_ratio: 0.35
  threshold: 0.65

# ============ IDE INTEGRATIONS ============
toolsets:
  - hermes-cli
  - web
  - browser
  - file
  - terminal
  - code_execution
  - memory
  - skills
  
  # IDE/Editor integrations
  - vscode        # VS Code integration
  - cursor        # Cursor IDE integration
  - intellij      # JetBrains IDEs
  - neovim        # Neovim integration
  
  # Testing frameworks
  - pytest        # Python testing
  - jest          # JavaScript testing
  - vitest        # Vite testing
  - mocha         # Node.js testing
  - junit         # Java testing
  - rspec         # Ruby testing
  
  # Cloud & Deployment (Free tiers)
  - vercel        # Vercel deployment
  - netlify       # Netlify deployment  
  - heroku        # Heroku deployment
  - railway       # Railway deployment
  - fly           # Fly.io deployment
  - cloudflare    # Cloudflare Workers
  - aws           # AWS (free tier)
  - gcp           # Google Cloud (free tier)
  - azure         # Azure (free tier)

