{
   "action": {
   },
   "background": {
      "service_worker": "background.js"
   },
   "content_scripts": [ {
      "js": [ "content-scripts/bridge.js" ],
      "matches": [ "https://chatgptsheets.app/*" ],
      "run_at": "document_start"
   }, {
      "css": [ "content-scripts/googleSheets.css" ],
      "js": [ "content-scripts/googleSheets.js" ],
      "matches": [ "*://docs.google.com/spreadsheets/*" ]
   } ],
   "default_locale": "en",
   "description": "__MSG_shortDesc__",
   "host_permissions": [ "http://localhost/*", "https://*.sentry.io/*", "https://*.ingest.us.sentry.io/*" ],
   "icons": {
      "128": "icon/128.png",
      "16": "icon/16.png",
      "32": "icon/32.png",
      "48": "icon/48.png",
      "96": "icon/96.png"
   },
   "key": "",
   "manifest_version": 3,
   "name": "__MSG_appName__",
   "permissions": [ "tabs", "storage", "sidePanel" ],
   "side_panel": {
      "default_path": "sidepanel.html"
   },
   "update_url": "https://clients2.google.com/service/update2/crx",
   "version": "3.0.3"
}
