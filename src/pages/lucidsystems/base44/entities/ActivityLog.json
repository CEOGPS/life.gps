{
  "name": "ActivityLog",
  "type": "object",
  "properties": {
    "severity": {
      "type": "string",
      "enum": ["info", "warning", "error", "success"],
      "default": "info"
    },
    "actor": {
      "type": "string",
      "enum": ["agent", "user", "system"],
      "default": "system"
    },
    "detail": {
      "type": "string"
    }
  },
  "required": ["severity", "actor", "detail"]
}
