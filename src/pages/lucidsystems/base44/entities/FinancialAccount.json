{
  "name": "FinancialAccount",
  "type": "object",
  "properties": {
    "provider": {
      "type": "string",
      "enum": ["stripe", "gumroad", "paypal"]
    },
    "connection_status": {
      "type": "string",
      "enum": ["connected", "disconnected", "pending"],
      "default": "disconnected"
    },
    "total_earned": {
      "type": "number",
      "default": 0
    },
    "pending_payout": {
      "type": "number",
      "default": 0
    }
  },
  "required": ["provider", "connection_status"]
}
