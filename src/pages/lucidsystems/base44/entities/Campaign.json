{
  "name": "Campaign",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "strategy_id": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": ["active", "paused", "stopped", "completed"],
      "default": "active"
    },
    "earnings_total": {
      "type": "number",
      "default": 0
    },
    "progress": {
      "type": "number",
      "default": 0
    },
    "current_step": {
      "type": "string"
    },
    "last_synced": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": ["name", "status"]
}
