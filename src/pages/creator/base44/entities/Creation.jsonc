{
  "name": "Creation",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "User-given or auto-generated title",
    },
    "type": {
      "type": "string",
      "enum": [
        "text_to_image",
        "image_edit",
        "image_to_video",
        "music_video",
        "storyboard_to_video",
      ],
      "description": "Type of creation",
    },
    "prompt": {
      "type": "string",
      "description": "The text prompt used",
    },
    "input_file_url": {
      "type": "string",
      "description": "URL of uploaded input file (image or audio)",
    },
    "input_file_urls": {
      "type": "string",
      "description": "JSON-serialized array of multiple uploaded file URLs",
    },
    "output_url": {
      "type": "string",
      "description": "URL of the generated output (image or video)",
    },
    "output_type": {
      "type": "string",
      "enum": ["image", "video"],
      "description": "Whether output is image or video",
    },
    "style_notes": {
      "type": "string",
      "description": "AI-extracted style notes for memory continuity",
    },
    "memory_context": {
      "type": "string",
      "description": "Serialized context from previous creations used",
    },
    "project_id": {
      "type": "string",
      "description": "ID of the project this creation belongs to, if any",
    },
  },
  "required": ["type", "output_url", "output_type"],
}
