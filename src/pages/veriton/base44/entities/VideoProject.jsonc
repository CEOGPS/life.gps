{
  "name": "VideoProject",
  "type": "object",
  "properties": {
    "trackId": {
      "type": "string",
    },
    "creationMode": {
      "type": "string",
      "enum": ["text-to-video", "photo-animation", "template", "auto-pilot"],
      "default": "auto-pilot",
    },
    "inputData": {
      "type": "object",
    },
    "status": {
      "type": "string",
      "enum": ["rendering", "ready", "published"],
      "default": "rendering",
    },
    "outputVideoUrl": {
      "type": "string",
    },
    "subtitleStyle": {
      "type": "object",
    },
    "transitionSpeed": {
      "type": "number",
      "default": 1,
    },
    "aspectRatio": {
      "type": "string",
      "enum": ["16:9", "9:16"],
      "default": "16:9",
    },
    "resolution": {
      "type": "string",
      "default": "4K",
    },
    "fps": {
      "type": "number",
      "default": 30,
    },
    "templateName": {
      "type": "string",
    },
  },
  "required": ["trackId"],
}
