{
  "name": "VoiceProfile",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
    },
    "voiceId": {
      "type": "string",
    },
    "consentGiven": {
      "type": "boolean",
      "default": false,
    },
    "uploadedFileUrl": {
      "type": "string",
    },
    "suggestedBpm": {
      "type": "number",
    },
  },
  "required": ["name"],
}
