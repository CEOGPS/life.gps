{
  "name": "Track",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
    },
    "lyrics": {
      "type": "string",
    },
    "genre": {
      "type": "string",
    },
    "genreSecondary": {
      "type": "string",
    },
    "genreBlend": {
      "type": "number",
      "default": 100,
    },
    "mood": {
      "type": "string",
    },
    "delivery": {
      "type": "string",
    },
    "gender": {
      "type": "string",
      "enum": ["Male", "Female", "Both"],
      "default": "Male",
    },
    "voiceTypes": {
      "type": "array",
      "items": {
        "type": "string",
      },
    },
    "voiceBlend": {
      "type": "object",
    },
    "voiceProfileId": {
      "type": "string",
    },
    "bpm": {
      "type": "number",
      "default": 120,
    },
    "key": {
      "type": "string",
      "default": "C Major",
    },
    "duration": {
      "type": "number",
      "default": 0,
    },
    "coverArtUrl": {
      "type": "string",
    },
    "audioFileUrl": {
      "type": "string",
    },
    "stemUrls": {
      "type": "object",
    },
    "status": {
      "type": "string",
      "enum": ["generating", "ready", "published"],
      "default": "generating",
    },
    "id3Tags": {
      "type": "object",
    },
    "fxSettings": {
      "type": "object",
    },
    "playlistIds": {
      "type": "array",
      "items": {
        "type": "string",
      },
    },
  },
  "required": ["title"],
}
