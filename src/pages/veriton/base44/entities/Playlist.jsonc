{
  "name": "Playlist",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
    },
    "coverMosaicUrls": {
      "type": "array",
      "items": {
        "type": "string",
      },
    },
    "trackIds": {
      "type": "array",
      "items": {
        "type": "string",
      },
    },
    "color": {
      "type": "string",
      "default": "#DC143C",
    },
  },
  "required": ["name"],
}
